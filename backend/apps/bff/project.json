{
  "name": "bff",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/apps/bff/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/backend/apps/bff/src"],
      "options": {
        "command": "npx tsc -p backend/apps/bff/tsconfig.app.json --outDir dist/ && npx tsc-alias -p backend/apps/bff/tsconfig.app.json --dir dist/ --resolve-full-paths"
      },
      "configurations": {
        "development": {
          "command": "npx tsc -p backend/apps/bff/tsconfig.app.json --outDir dist/"
        },
        "production": {
          "command": "npx tsc -p backend/apps/bff/tsconfig.app.json --outDir dist/ && npx tsc-alias -p backend/apps/bff/tsconfig.app.json --dir dist/ --resolve-full-paths"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "command": "node ./dist/backend/apps/bff/src/main.js"
      },
      "configurations": {
        "development": {
          "buildTarget": "bff:build:development"
        },
        "production": {
          "buildTarget": "bff:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "backend/apps/bff/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["backend/apps/bff/**/*.ts"]
      }
    }
  }
}
