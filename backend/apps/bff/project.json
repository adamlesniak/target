{
  "name": "bff",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/apps/bff/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/backend/apps/bff"],
      "options": {
        "command": "npx tsc -p backend/apps/bff/tsconfig.app.json --outDir dist/backend/apps/bff && npx tsc-alias -p backend/apps/bff/tsconfig.app.json --dir dist/backend/apps/bff --resolve-full-paths"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "bff:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "bff:build:development"
        },
        "production": {
          "buildTarget": "bff:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "backend/apps/bff/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["backend/apps/bff/**/*.ts"]
      }
    }
  }
}
